<resources>
    <dimen name="surpride_space_unit">4dp</dimen>
    <dimen name="surpride_page_inset">32dp</dimen>
    <dimen name="surpride_card_padding">24dp</dimen>
    <dimen name="surpride_control_height">104dp</dimen>
    <dimen name="surpride_control_radius">4dp</dimen>
    <dimen name="surpride_card_radius">0dp</dimen>
    <dimen name="surpride_type_body">24sp</dimen>
    <dimen name="surpride_type_supporting">20sp</dimen>
    <dimen name="surpride_type_title">32sp</dimen>
    <style name="Widget.Surpride.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/surpride_control_height</item>
        <item name="android:textSize">@dimen/surpride_type_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/surpride_control_radius</item>
        <item name="backgroundTint">@color/surpride_accent_fill</item>
        <item name="android:textColor">@color/surpride_on_accent</item>
    </style>
</resources>
